{
  "name": "blue-archive-figures",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "figures:collect": "tsx scripts/collect.ts",
    "figures:characters": "tsx scripts/fetch-characters.ts",
    "figures:images": "tsx scripts/fetch-images.ts",
    "figures:multiimages": "tsx scripts/backfill-images.ts",
    "figures:portraits": "tsx scripts/fetch-portraits.ts",
    "figures:generate": "tsx scripts/generate.ts",
    "figures:add": "tsx scripts/add-figure.ts",
    "figures:refresh": "npm run figures:collect && npm run figures:characters && npm run figures:images && npm run figures:portraits && npm run figures:generate"
  },
  "dependencies": {
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.49.0",
    "tsx": "^4",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
